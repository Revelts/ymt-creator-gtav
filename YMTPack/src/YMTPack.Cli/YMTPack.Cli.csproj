<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ymtpack</AssemblyName>
    <RootNamespace>YMTPack.Cli</RootNamespace>
    <!-- No culture data needed; lets self-contained Linux builds run without libicu. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YMTPack.Core\YMTPack.Core.csproj" />
  </ItemGroup>

</Project>
